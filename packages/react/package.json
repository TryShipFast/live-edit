{
  "name": "@shipfasts/live-edit-react",
  "version": "0.14.3",
  "description": "ShipFast Live Edit for React and Next.js: in-place editing of the static words and assets in your templates.",
  "keywords": [
    "live-edit",
    "in-place-editing",
    "cms",
    "react",
    "nextjs",
    "codemod"
  ],
  "homepage": "https://tryshipfast.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryShipFast/live-edit.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://tryshipfast.com/support"
  },
  "author": "TryShipFast (https://tryshipfast.com)",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    }
  },
  "bin": {
    "live-edit-codemod": "bin/live-edit-codemod.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@babel/parser": "^7.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
